{
  "name": "pricelock",
  "version": "1.0.0",
  "description": "Reference implementation: write catalog prices into a static site's HTML, keyed by catalog item id, with a committed snapshot and an offline three-way consistency check.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "bake-prices": "bin/bake-prices.mjs"
  },
  "scripts": {
    "bake": "node bin/bake-prices.mjs --write",
    "check": "node bin/bake-prices.mjs --check",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10USTECH/pricelock.git"
  },
  "keywords": [
    "static-site",
    "jamstack",
    "catalog",
    "pricing",
    "json-ld",
    "build-time"
  ]
}
